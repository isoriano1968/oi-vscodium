+#elif defined(__sun)
+
+/*
+ * illumos: the name of the foreground process group leader, from
+ * /proc/<pgrp>/psinfo. tcgetpgrp(3C) fails with ENOTTY on the master side and
+ * on a slave that is not our controlling terminal, but the TIOCGPGRP ioctl on
+ * the slave named by tty answers.
+ */
+static char *
+pty_getproc(int fd, char *tty) {
+  char path[64];
+  psinfo_t psinfo;
+  pid_t pgrp;
+  ssize_t n;
+  int pfd, sfd, r;
+
+  if (tty == NULL || (sfd = open(tty, O_RDONLY | O_NOCTTY | O_NONBLOCK)) == -1) {
+    return NULL;
+  }
+  r = ioctl(sfd, TIOCGPGRP, &pgrp);
+  close(sfd);
+  if (r == -1) {
+    return NULL;
+  }
+
+  snprintf(path, sizeof (path), "/proc/%d/psinfo", (int)pgrp);
+  if ((pfd = open(path, O_RDONLY)) == -1) {
+    return NULL;
+  }
+  n = read(pfd, &psinfo, sizeof (psinfo));
+  close(pfd);
+  if (n != (ssize_t)sizeof (psinfo) || psinfo.pr_fname[0] == '\0') {
+    return NULL;
+  }
+
+  return strdup(psinfo.pr_fname);
+}

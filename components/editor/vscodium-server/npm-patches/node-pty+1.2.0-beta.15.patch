+static int
+pty_nonblock(int);
+
+/**
+ * illumos has no openpty(3) or forkpty(3). Build them from posix_openpt(3C),
+ * grantpt(3C), unlockpt(3C) and ptsname(3C), as in the pts(4D) manual page.
+ */
+static int
+pty_openpty(int *amaster, int *aslave, char *name, size_t namelen,
+            const struct termios *termp, const struct winsize *winp) {
+  int master, slave, err;
+  const char *slavename;
+
+  if ((master = posix_openpt(O_RDWR | O_NOCTTY)) == -1)
+    return -1;
+  if (grantpt(master) == -1 || unlockpt(master) == -1 ||
+      (slavename = ptsname(master)) == NULL)
+    goto fail;
+  if (name != NULL && strlcpy(name, slavename, namelen) >= namelen) {
+    errno = ENAMETOOLONG;
+    goto fail;
+  }
+  if ((slave = open(slavename, O_RDWR | O_NOCTTY)) == -1)
+    goto fail;
+  /* Push the terminal STREAMS modules unless they are already there. */
+  if (ioctl(slave, I_FIND, "ldterm") == 0 &&
+      (ioctl(slave, I_PUSH, "ptem") == -1 ||
+       ioctl(slave, I_PUSH, "ldterm") == -1 ||
+       ioctl(slave, I_PUSH, "ttcompat") == -1)) {
+    err = errno;
+    close(slave);
+    errno = err;
+    goto fail;
+  }
+  if ((termp != NULL && tcsetattr(slave, TCSAFLUSH, termp) == -1) ||
+      (winp != NULL && ioctl(slave, TIOCSWINSZ, winp) == -1)) {
+    err = errno;
+    close(slave);
+    errno = err;
+    goto fail;
+  }
+  *amaster = master;
+  *aslave = slave;
+  return 0;
+
+fail:
+  err = errno;
+  close(master);
+  errno = err;
+  return -1;
+}
+
+static pid_t
+pty_forkpty(int *amaster, const struct termios *termp,
+            const struct winsize *winp) {
+  int master, slave, fd;
+  char name[64];
+  pid_t pid;
+
+  if (pty_openpty(&master, &slave, name, sizeof (name), termp, winp) == -1)
+    return -1;
+
+  switch (pid = fork()) {
+    case -1:
+      close(master);
+      close(slave);
+      return -1;
+    case 0:
+      close(master);
+      if (setsid() == -1)
+        _exit(1);
+      /*
+       * The first terminal that a session leader opens without O_NOCTTY
+       * becomes its controlling terminal.
+       */
+      if ((fd = open(name, O_RDWR)) == -1)
+        _exit(1);
+      close(fd);
+      if (dup2(slave, STDIN_FILENO) == -1 ||
+          dup2(slave, STDOUT_FILENO) == -1 ||
+          dup2(slave, STDERR_FILENO) == -1)
+        _exit(1);
+      if (slave > STDERR_FILENO)
+        close(slave);
+      return 0;
+    default:
+      close(slave);
+      *amaster = master;
+      return pid;
+  }
+}
+
+/* Close all file descriptors >= 3 in the child before exec. */
+static void
+pty_close_inherited_fds() {
+  closefrom(3);
+}
+
+/*
+ * The master side of an illumos pty is a STREAMS device without the terminal
+ * modules, so isatty(3C) is false for it and libuv's uv_tty_init() (which
+ * tty.ReadStream uses) rejects it with EINVAL. JavaScript therefore gets one
+ * end of a socket pair, and a relay thread copies between the other end and
+ * the master. pty_relay_master maps the JavaScript fd to the master fd for
+ * resize() and process().
+ */
+static std::mutex pty_relay_mutex;
+static std::map<int, int> pty_relay_master;
+
+static int
+pty_master_fd(int fd) {
+  std::lock_guard<std::mutex> lock(pty_relay_mutex);
+  auto it = pty_relay_master.find(fd);
+  return it == pty_relay_master.end() ? fd : it->second;
+}
+
+struct pty_relay_dir {
+  int from, to;
+  char buf[16384];
+  size_t len, off;
+  bool eof;
+};
+
+static void
+pty_relay(int jsfd, int master, int sock) {
+  struct pty_relay_dir d[2] = {
+    { master, sock, {0}, 0, 0, false },  /* output of the child */
+    { sock, master, {0}, 0, 0, false }   /* input from JavaScript */
+  };
+
+  for (;;) {
+    struct pollfd pfd[2];
+    pfd[0].fd = master;
+    pfd[1].fd = sock;
+    pfd[0].events = pfd[1].events = 0;
+    /* read when the buffer is empty, write when it holds data */
+    if (d[0].len == 0 && !d[0].eof) pfd[0].events |= POLLIN;
+    if (d[1].len > 0) pfd[0].events |= POLLOUT;
+    if (d[1].len == 0 && !d[1].eof) pfd[1].events |= POLLIN;
+    if (d[0].len > 0) pfd[1].events |= POLLOUT;
+
+    /* the child is gone and its output is delivered, or JavaScript closed */
+    if ((d[0].eof && d[0].len == 0) || d[1].eof)
+      break;
+
+    if (poll(pfd, 2, -1) == -1) {
+      if (errno == EINTR) continue;
+      break;
+    }
+
+    bool failed = false;
+    for (int i = 0; i < 2; i++) {
+      struct pty_relay_dir *r = &d[i];
+      struct pollfd *in = &pfd[i == 0 ? 0 : 1];
+      struct pollfd *out = &pfd[i == 0 ? 1 : 0];
+
+      if (r->len == 0 && !r->eof && (in->revents & (POLLIN | POLLHUP | POLLERR))) {
+        ssize_t n = read(r->from, r->buf, sizeof (r->buf));
+        if (n > 0) {
+          r->len = (size_t)n;
+          r->off = 0;
+        } else if (n == 0 || (errno != EAGAIN && errno != EINTR)) {
+          /* EOF, or EIO once the last process on the slave side exits */
+          r->eof = true;
+        }
+      }
+      if (r->len > 0 && (out->revents & (POLLOUT | POLLHUP | POLLERR))) {
+        ssize_t n = write(r->to, r->buf + r->off, r->len - r->off);
+        if (n > 0) {
+          r->off += (size_t)n;
+          if (r->off == r->len) r->len = r->off = 0;
+        } else if (n == -1 && errno != EAGAIN && errno != EINTR) {
+          failed = true;
+        }
+      }
+    }
+    if (failed)
+      break;
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(pty_relay_mutex);
+    pty_relay_master.erase(jsfd);
+  }
+  /* closing sock ends the JavaScript stream; closing master hangs up the slave */
+  close(sock);
+  close(master);
+}
+
+/* Gives JavaScript a socket for the master and starts the relay thread. */
+static int
+pty_relay_start(int master) {
+  int sv[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM, 0, sv) == -1)
+    return -1;
+  if (pty_nonblock(master) == -1 || pty_nonblock(sv[1]) == -1 ||
+      fcntl(sv[0], F_SETFD, FD_CLOEXEC) == -1 ||
+      fcntl(sv[1], F_SETFD, FD_CLOEXEC) == -1 ||
+      fcntl(master, F_SETFD, FD_CLOEXEC) == -1) {
+    close(sv[0]);
+    close(sv[1]);
+    return -1;
+  }
+  {
+    std::lock_guard<std::mutex> lock(pty_relay_mutex);
+    pty_relay_master[sv[0]] = master;
+  }
+  std::thread(pty_relay, sv[0], master, sv[1]).detach();
+  return sv[0];
+}

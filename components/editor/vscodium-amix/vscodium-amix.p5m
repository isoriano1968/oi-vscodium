set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description value="$(COMPONENT_DESCRIPTION)"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

# A built-in extension: VSCodium loads it from its own extensions directory.
depend type=require fmri=editor/vscodium

file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/images/amix-logo.png
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/language-configuration.json
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/package.json
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/readme.md
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/samples/cde-hello/Makefile
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/samples/cde-hello/README.md
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/samples/cde-hello/amix-fix-needed
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/samples/cde-hello/hello.c
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/samples/console-hello/Makefile
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/samples/console-hello/README.md
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/samples/console-hello/amix-fix-needed
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/samples/console-hello/hello.c
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/snippets/c.json
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/snippets/m68k.json
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/src/agent-link.js
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/src/extension.js
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/src/launch.js
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/src/target.js
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/syntaxes/m68k.tmLanguage.json
file path=usr/lib/vscodium/resources/app/extensions/vscode-amix/vscode.license

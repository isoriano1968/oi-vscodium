 		}
 
-		if (process.platform === 'win32' || process.platform === 'linux') {
+		if (process.platform === 'win32' || (process.platform === 'linux' || process.platform === 'sunos')) {
 			return path.join(getApplicationPath(), 'data');
 		}
 
